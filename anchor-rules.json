    "helpSections": [
      [
        "快速上手（3 步）",
        [
          "1) 打开商品详情页 → 点右下角悬浮球展开面板",
          "2) 面板自动读取：主图 / SKU图 / 详情图 / 视频 / SKU规格 / 商品参数",
          "3) 勾选要的图 → 底部「下载」；或用「复制」拿到结构化链接"
        ]
      ],
      [
        "采集不到图片 / 数量变少",
        [
          "· 先点面板底部「立即更新规则」——平台改版后我们通常已远程推好新规则，不用等扩展升级",
          "· 再点「重新读取」；仍不行刷新页面重试一次",
          "· 京东详情图是滚动懒加载，面板会自动滚到底再收图，请勿中途关页"
        ]
      ],
      [
        "SKU 图是空的",
        [
          "· 部分商品本身没有 SKU 图（只有文字规格），为空属正常",
          "· 确保停留在「SKU采集」页并等采集完成",
          "· 平台若改接口字段名，我们会远程加别名修复"
        ]
      ],
      [
        "评论采集失败 / 条数少",
        [
          "· 未登录时平台只放少量评论，建议先登录",
          "· 免费版评论最多 10 页，专业版不限量",
          "· 「问大家」与全部回答需勾选后才采集"
        ]
      ],
      [
        "下载没反应 / 找不到文件",
        [
          "· 到浏览器默认下载目录找（可点「打开下载目录」）",
          "· 勾了「下载为 ZIP」得到压缩包；取消勾选直接下原图",
          "· 若浏览器拦截下载/弹窗，请允许本页"
        ]
      ],
      [
        "格式与画质",
        [
          "· 支持 JPG / PNG / WEBP / AVIF / JFIF，可设质量与缩放",
          "· 选「原始格式」即下平台原图，不压缩"
        ]
      ],
      [
        "以图搜货（找同款货源）",
